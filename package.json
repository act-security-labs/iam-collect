{
  "name": "@actsecurity/iam-collect",
  "version": "0.1.218",
  "description": "Collect IAM information from AWS Accounts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/act-security-labs/iam-collect.git"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "types": "dist/cjs/index.d.ts",
  "bin": {
    "iam-collect": "dist/esm/cli.js"
  },
  "scripts": {
    "build": "npx tsc -p tsconfig.cjs.json && npx tsc -p tsconfig.esm.json && ./postbuild.sh",
    "clean": "rm -rf dist",
    "test": "npx vitest --run --coverage",
    "release": "npm install && npm run clean && npm run build && npm test && npm run format-check && npm publish",
    "format": "npx prettier --write src/ infrastructure_as_code/",
    "format-check": "npx prettier --check src/"
  },
  "keywords": [
    "AWS",
    "IAM"
  ],
  "author": "David Kerber <dave@cloudcopilot.io>",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/act-security-labs/iam-collect/issues"
  },
  "homepage": "https://github.com/act-security-labs/iam-collect#readme",
  "devDependencies": {
    "@actsecurity/prettier-config": "^0.1.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.4",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.5.0",
    "@vitest/coverage-v8": "^4.0.18",
    "aws-sdk-client-mock": "^4.1.0",
    "semantic-release": "^25.0.3",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  },
  "prettier": "@actsecurity/prettier-config",
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "releaseRules": [
            {
              "type": "feat",
              "release": "patch"
            },
            {
              "type": "fix",
              "release": "patch"
            },
            {
              "breaking": true,
              "release": "patch"
            },
            {
              "type": "*",
              "release": "patch"
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": true
        }
      ],
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "echo \"/**\n * iam-collect version.\n * Generated by build, do not manually edit\n */\nexport const IAM_COLLECT_VERSION = '${nextRelease.version}'\" > src/config/version.ts",
          "successCmd": "echo published=true >> $GITHUB_OUTPUT && echo version=${nextRelease.version} >> $GITHUB_OUTPUT && echo package_name=$(node -p \"require('./package.json').name\") >> $GITHUB_OUTPUT"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "package-lock.json",
            "CHANGELOG.md",
            "src/config/version.ts"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]"
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": []
        }
      ]
    ]
  },
  "dependencies": {
    "@aws-sdk/client-account": "^3.758.0",
    "@aws-sdk/client-api-gateway": "^3.799.0",
    "@aws-sdk/client-backup": "^3.812.0",
    "@aws-sdk/client-config-service": "^3.886.0",
    "@aws-sdk/client-dynamodb": "^3.788.0",
    "@aws-sdk/client-dynamodb-streams": "^3.816.0",
    "@aws-sdk/client-ec2": "^3.798.0",
    "@aws-sdk/client-ecr": "^3.798.0",
    "@aws-sdk/client-efs": "^3.806.0",
    "@aws-sdk/client-eks": "^3.1085.0",
    "@aws-sdk/client-eventbridge": "^3.873.0",
    "@aws-sdk/client-glacier": "^3.799.0",
    "@aws-sdk/client-glue": "^3.812.0",
    "@aws-sdk/client-iam": "^3.777.0",
    "@aws-sdk/client-kafka": "^3.876.0",
    "@aws-sdk/client-kinesis": "^3.873.0",
    "@aws-sdk/client-kms": "^3.782.0",
    "@aws-sdk/client-lambda": "^3.782.0",
    "@aws-sdk/client-opensearch": "^3.882.0",
    "@aws-sdk/client-organizations": "^3.787.0",
    "@aws-sdk/client-ram": "^3.806.0",
    "@aws-sdk/client-s3": "^3.937.0",
    "@aws-sdk/client-s3-control": "^3.787.0",
    "@aws-sdk/client-s3outposts": "^3.817.0",
    "@aws-sdk/client-s3tables": "^3.804.0",
    "@aws-sdk/client-secrets-manager": "^3.787.0",
    "@aws-sdk/client-ses": "^3.1121.0",
    "@aws-sdk/client-sns": "^3.797.0",
    "@aws-sdk/client-sqs": "^3.798.0",
    "@aws-sdk/client-sso-admin": "^3.787.0",
    "@aws-sdk/client-sts": "^3.772.0",
    "@aws-sdk/credential-providers": "^3.772.0",
    "@aws-sdk/types": "^3.734.0",
    "@actsecurity/cli": "^0.2.5",
    "@actsecurity/iam-policy": "^0.1.24",
    "@actsecurity/iam-utils": "^0.1.56",
    "@actsecurity/job": "^0.1.65",
    "@actsecurity/log": "^0.1.60",
    "@smithy/smithy-client": "^4.2.0",
    "@smithy/util-retry": "^4.0.2",
    "better-sqlite3": "^12.2.0",
    "jsonc-parser": "^3.3.1"
  }
}
